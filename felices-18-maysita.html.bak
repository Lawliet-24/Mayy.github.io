<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f6f0e6"><meta name="description" content="18 vueltas al sol de mi persona favorita. Feliz cumpleaños, Maysita. Con todo mi amor, Briam.">
<title>18 vueltas al sol · Para Maysita ♥</title>
<style>
:root{--paper:#f6f0e6;--ink:#492c30;--red:#a32f46;--pink:#edbcc2;--muted:#796365;--line:#d9c8bf;--serif:Georgia,'Times New Roman',serif;--sans:'Trebuchet MS',Arial,sans-serif}*{box-sizing:border-box}[hidden]{display:none!important}html{scroll-behavior:smooth;scroll-padding-top:85px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);overflow-x:hidden}body:before{content:'';position:fixed;inset:0;pointer-events:none;opacity:.13;z-index:15;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23775a4d' opacity='.28' filter='url(%23n)' d='M0 0h160v160H0z'/%3E%3C/svg%3E")}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit;cursor:pointer}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #bb753b;outline-offset:6px}button{color:inherit}img{display:block;width:100%;height:100%;object-fit:cover}button svg{pointer-events:none}::selection{background:var(--pink)}.skip{position:fixed;top:-80px;left:15px;z-index:100;background:var(--paper);padding:15px}.skip:focus{top:10px}.top{height:77px;padding:0 4%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:relative;z-index:4}.brand{font-family:var(--serif);font-style:italic;font-size:25px}.brand span{font-size:16px;color:var(--red);padding:0 6px}.nav{display:flex;gap:30px;font-size:12px}.nav a:hover{color:var(--red)}.sound{background:none;border:1px solid var(--line);padding:10px 14px;border-radius:24px;font-size:11px;letter-spacing:.03em;min-height:40px}.eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:bold;line-height:1.7}.hero{min-height:800px;height:calc(100svh - 77px);max-height:1040px;position:relative;display:grid;place-items:center;isolation:isolate;overflow:hidden}.orbit{position:absolute;width:1080px;height:680px;border:1px solid #d7b8b188;border-radius:50%;transform:rotate(-20deg);z-index:-2}.orbit.two{width:1230px;height:850px;transform:rotate(22deg);border-style:dashed;opacity:.5}.hero-center{width:min(560px,50%);text-align:center;position:relative;z-index:2;margin-top:-40px}.birthday-date{display:inline-flex;gap:12px;align-items:center;border:1px solid #cfb5ac;border-radius:30px;padding:9px 18px;font-size:10px;letter-spacing:.16em}.birthday-date b{font-size:14px;color:var(--red)}.hero-number{font:italic clamp(170px,23vw,300px)/.86 var(--serif);letter-spacing:-.1em;color:var(--red);margin:30px 20px 0 0}.hero h1{font:normal clamp(50px,6.5vw,88px)/1 var(--serif);letter-spacing:-.055em;margin:-2px 0 22px}.hero h1 em{font-weight:normal;display:block;font-size:.7em;margin-bottom:6px;color:var(--red)}.hero p{font-size:14px;line-height:1.75;max-width:310px;margin:0 auto 25px}.pill{display:inline-flex;align-items:center;gap:27px;background:var(--red);color:#fff7ed;border:1px solid var(--red);padding:17px 25px;border-radius:50px;font-size:12px;transition:transform .3s,background .3s}.pill:hover{transform:translateY(-3px);background:#87243a}.pill.light{background:var(--paper);color:var(--red);border:0}.polaroid{background:#fffcf5;padding:9px 9px 30px;box-shadow:0 12px 30px #623d3020;position:absolute;width:175px;height:237px;transform:rotate(var(--rot));animation:float 7s ease-in-out infinite;animation-delay:var(--delay,0s);border:0}.polaroid img{object-position:center 35%}.polaroid:after{content:attr(data-caption);font:italic 15px var(--serif);position:absolute;bottom:8px;left:0;right:0;text-align:center}.polaroid:hover{z-index:5;animation-play-state:paused;outline:1px solid var(--red)}.polaroid:before{content:'';position:absolute;top:-8px;left:calc(50% - 24px);width:48px;height:20px;background:#dec9ad90;transform:rotate(-8deg)}.photo-a{left:7%;top:14%;--rot:-12deg;--delay:-2s}.photo-b{right:6%;top:12%;--rot:10deg;--delay:-4s;width:190px;height:250px}.photo-c{left:13%;bottom:11%;--rot:7deg;--delay:-1s;width:150px;height:198px}.photo-d{right:12%;bottom:10%;--rot:-8deg;--delay:-5s;width:155px;height:205px}.sun{position:absolute;font:60px var(--serif);color:#b58b4e;left:27%;top:9%;animation:spin 40s linear infinite}.twinkle{position:absolute;font-size:30px;color:var(--red);right:27%;bottom:20%;animation:float 5s ease-in-out infinite}.hero-foot{position:absolute;bottom:28px;left:4%;right:4%;display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em;text-transform:uppercase}.hero-foot a{border-bottom:1px solid var(--ink);padding-bottom:7px}.marquee{border-top:1px solid var(--red);border-bottom:1px solid var(--red);background:var(--red);color:var(--paper);overflow:hidden;padding:15px 0}.marquee div{display:flex;gap:40px;width:max-content;animation:marquee 32s linear infinite;font:italic 24px var(--serif)}.marquee span{white-space:nowrap}.marquee i{font-style:normal;color:#e7b9a3}section{scroll-margin-top:30px}.wrap{max-width:1180px;margin:auto;padding:110px 5%}.section-top{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:45px}.section-top h2,h2.title{font:normal clamp(40px,5vw,65px)/1.06 var(--serif);letter-spacing:-.045em;margin:15px 0 0}.section-top h2 em,h2.title em{color:var(--red);font-weight:normal}.section-top p{font-size:13px;line-height:1.8;max-width:260px;color:var(--muted);margin:0}.photo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;align-items:start}.memory{padding:0;background:none;border:none;text-align:left;position:relative;transition:transform .4s}.memory:nth-child(even){margin-top:45px}.memory img{height:315px;border-radius:120px 120px 4px 4px;filter:saturate(.85);transition:filter .4s,transform .4s}.memory:nth-child(3n) img{border-radius:4px}.memory:hover{transform:translateY(-8px)}.memory:hover img{filter:saturate(1)}.memory .caption{display:flex;justify-content:space-between;gap:8px;margin-top:14px;font:italic 18px var(--serif)}.memory .caption b{font:10px var(--sans);padding-top:5px;color:var(--muted)}.photo-grid .memory:nth-child(n+5) img{height:265px}.gallery-bottom{display:flex;justify-content:space-between;margin-top:35px;font-size:10px;letter-spacing:.09em;color:var(--muted);border-top:1px solid var(--line);padding-top:20px}.cinema{background:#38252d;color:var(--paper);position:relative;overflow:hidden}.cinema:before{content:'';width:800px;height:800px;position:absolute;left:-500px;top:0;border:1px solid #ffffff15;border-radius:50%;box-shadow:0 0 0 100px #ffffff03,0 0 0 200px #ffffff03;pointer-events:none}.cinema .eyebrow{color:#e4b5b7}.cinema h2 em{color:#eabfc0}.cinema .section-top p{color:#c9b8b9}.cinema-layout{display:grid;grid-template-columns:minmax(240px,1fr) 1.15fr;gap:8%;align-items:center}.screen{position:relative;border:1px solid #a47a7d50;padding:16px;background:#24191e;max-width:370px;margin:0 auto;width:100%;box-shadow:0 20px 50px #0003}.screen:before{content:'●  RECUERDOS EN MOVIMIENTO';font-size:8px;letter-spacing:.16em;display:block;margin:0 0 13px;color:#dcb0b1}.screen video{width:100%;height:470px;display:block;object-fit:contain;background:#120e11}.screen small{display:block;font-size:10px;letter-spacing:.08em;padding:12px 0 0;color:#c4acad}.playlist{display:grid;gap:0}.clip{background:none;color:var(--paper);border:0;border-bottom:1px solid #ffffff25;display:grid;grid-template-columns:35px 1fr 30px;gap:10px;text-align:left;align-items:center;padding:26px 0}.clip>span:first-child{font-size:10px;color:#d5b1b4}.clip strong{font:26px var(--serif);font-weight:normal;display:block}.clip small{display:block;margin-top:9px;font-size:11px;color:#c6b2b8}.clip .play{border:1px solid #ffffff50;border-radius:50%;width:32px;height:32px;display:grid;place-items:center;font-size:11px}.clip[aria-pressed=true]{color:#efc3bd}.clip[aria-pressed=true] .play{background:#edbcc2;color:#38252d}.cinema-note{font:italic 20px/1.6 var(--serif);max-width:350px;margin-top:35px;color:#dec8c7}.wishes{text-align:center;position:relative}.wishes .intro{max-width:420px;margin:24px auto 35px;font-size:13px;line-height:1.9;color:var(--muted)}.wish-display{max-width:660px;min-height:180px;margin:0 auto 30px;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:25px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.wish-display small{font-size:10px;letter-spacing:.15em;color:var(--red)}.wish-display p{font:italic clamp(24px,3vw,35px)/1.35 var(--serif);margin:18px 0 0}.wish-buttons{display:grid;grid-template-columns:repeat(9,1fr);gap:12px;max-width:710px;margin:0 auto}.wish-button{aspect-ratio:1;display:grid;place-items:center;background:transparent;border:1px solid #cfb5ae;border-radius:50%;font:italic 23px var(--serif);transition:all .25s;position:relative}.wish-button:hover{transform:translateY(-4px);background:#efdce0}.wish-button[aria-pressed=true]{background:var(--red);color:var(--paper);border-color:var(--red)}.wish-button.seen:after{content:'♥';position:absolute;font-size:8px;bottom:5px;right:12px}.wish-count{font-size:10px;letter-spacing:.12em;margin-top:25px;color:var(--muted)}.letter-section{background:#ecdfd2;padding:100px 5%;position:relative}.letter-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:8%;max-width:1050px;margin:auto;align-items:center}.letter-side h2{font:normal 56px/1.05 var(--serif);letter-spacing:-.045em;margin:20px 0}.letter-side h2 em{color:var(--red)}.letter-side>p{max-width:240px;font-size:13px;line-height:1.9;color:var(--muted)}.seal-art{font-size:70px;color:var(--red);font-family:var(--serif);display:block;margin:25px 0}.envelope{background:#f9f3e9;border:1px solid #d4bbb0;box-shadow:0 15px 30px #604b3510;position:relative;transform:rotate(-2deg)}.envelope summary{list-style:none;cursor:pointer;text-align:center;padding:70px 30px;position:relative;min-height:330px;background:linear-gradient(155deg,transparent 49.7%,#dfcdc0 50%,transparent 50.4%),linear-gradient(205deg,transparent 49.7%,#dfcdc0 50%,transparent 50.4%);display:grid;justify-items:center;align-content:center;gap:20px}.envelope summary::-webkit-details-marker{display:none}.wax{display:grid;place-items:center;width:72px;height:72px;background:var(--red);border-radius:50%;box-shadow:inset 0 0 0 5px #8a293e,inset 0 0 0 6px #c25e68,0 5px 10px #542a3030;font:italic 33px var(--serif);color:#f7cfcc}.envelope summary span:last-child{font:italic 23px var(--serif)}.envelope summary small{font-size:10px;letter-spacing:.13em}.envelope[open]{transform:rotate(0)}.envelope[open] summary{padding:22px;min-height:0;background:none;border-bottom:1px solid var(--line);display:flex;justify-content:space-between}.envelope[open] summary .wax{width:40px;height:40px;font-size:20px;flex-shrink:0}.envelope[open] summary small{display:none}.letter{padding:30px 38px 40px;font:17px/1.9 var(--serif)}.letter p{margin:0 0 20px}.letter .signature{font:italic 30px var(--serif);color:var(--red);margin-bottom:0}.birthday{text-align:center;padding-bottom:70px;position:relative;overflow:hidden}.birthday .title{max-width:650px;margin:20px auto}.birthday>p{font-size:13px;line-height:1.8;color:var(--muted);max-width:360px;margin:20px auto}.cake{width:300px;height:250px;margin:15px auto;position:relative}.cake svg{width:100%;height:100%;overflow:visible}.flame{transform-box:fill-box;transform-origin:center bottom;animation:flicker 1s alternate infinite;transition:opacity .6s}.blown .flame{opacity:0;animation:none}.cake .smoke{opacity:0;transition:opacity .5s}.blown .smoke{opacity:.5}.wish-result{font:italic 23px/1.5 var(--serif);color:var(--red);max-width:500px;margin:23px auto;min-height:70px}.reset{display:block;margin:20px auto;border:0;border-bottom:1px solid var(--line);padding:7px;background:none;font-size:11px}.footer{border-top:1px solid var(--line);padding:30px 5%;display:flex;justify-content:space-between;gap:20px;font-size:10px;letter-spacing:.08em}.footer .love{font:italic 20px var(--serif);letter-spacing:0;color:var(--red)}dialog{border:1px solid var(--line);padding:14px;background:var(--paper);color:var(--ink);max-width:min(90vw,620px);max-height:90svh;overflow:auto;border-radius:5px}dialog::backdrop{background:#25151cdb;backdrop-filter:blur(7px)}dialog img{max-height:68svh;height:auto;width:auto;max-width:100%;margin:auto;object-fit:contain}dialog .modal-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-top:15px}dialog p{font:italic 20px var(--serif);margin:0}dialog button{border:1px solid var(--line);background:none;border-radius:30px;padding:10px 18px}.modal-arrows{display:flex;gap:8px}.confetti{position:fixed;inset:0;pointer-events:none;z-index:30}.reveal{transition:opacity .8s,transform .8s}.js .reveal:not(.visible){opacity:0;transform:translateY(25px)}@keyframes float{0%,100%{translate:0 0}50%{translate:0 -13px}}@keyframes spin{to{rotate:360deg}}@keyframes marquee{to{transform:translateX(-50%)}}@keyframes flicker{to{transform:scale(.85,1.08) rotate(5deg)}}.motion-toggle{position:fixed;bottom:14px;left:14px;border:1px solid var(--line);background:#f6f0e6ed;border-radius:20px;padding:9px 12px;font-size:10px;z-index:20;box-shadow:0 2px 10px #0001}.still *, .still *:before, .still *:after{animation:none!important;scroll-behavior:auto!important;transition:none!important}.still .reveal{opacity:1!important;transform:none!important}
@media(min-width:1500px){.photo-a{left:15%}.photo-b{right:15%}.photo-c{left:20%}.photo-d{right:20%}}
@media(max-width:900px){.hero{min-height:750px}.polaroid{width:135px;height:190px}.photo-a{left:3%;top:13%}.photo-b{right:3%;top:12%}.photo-c{left:7%;bottom:12%;width:120px;height:160px}.photo-d{right:5%;bottom:13%;width:120px;height:165px}.hero-center{width:55%}.hero h1{font-size:61px}.hero-number{font-size:220px}.hero .sun{left:22%}.photo-grid{gap:18px}.memory img{height:235px}.photo-grid .memory:nth-child(n+5) img{height:220px}.wrap{padding:80px 5%}.letter-layout{gap:6%}.letter-side h2{font-size:45px}.letter{padding:25px}.cinema-layout{gap:6%}.screen video{height:400px}}
@media(max-width:600px){.top{height:67px;padding:0 6%}.brand{font-size:22px}.nav{gap:16px;font-size:10px}.nav .desktop{display:none}.sound{font-size:10px;padding:8px 10px}.hero{height:auto;min-height:850px;display:block;padding:290px 20px 100px}.hero-center{width:100%;margin:0}.hero-number{font-size:155px;margin:23px 12px 0 0}.hero h1{font-size:58px;margin-top:5px}.hero h1 em{font-size:37px}.hero p{font-size:13px;max-width:280px;margin-bottom:22px}.birthday-date{font-size:9px;padding:8px 14px}.hero .polaroid{top:45px;bottom:auto;width:137px;height:190px}.hero .photo-a{left:calc(50% - 145px);--rot:-12deg}.hero .photo-b{right:calc(50% - 145px);top:53px;--rot:11deg}.hero .photo-c,.hero .photo-d{display:none}.hero .sun{top:222px;left:13%;font-size:45px}.hero .twinkle{right:10%;bottom:23%;font-size:21px}.orbit{width:740px;height:500px;left:calc(50% - 370px);top:30px}.orbit.two{width:820px;height:700px;left:calc(50% - 410px)}.hero-foot{font-size:8px;left:6%;right:6%;bottom:28px}.hero-foot>span:first-child{display:none}.marquee div{font-size:22px}.wrap{padding:65px 6%}.section-top{display:block;margin-bottom:30px}.section-top p{margin-top:22px;max-width:300px;font-size:12px}.section-top h2,h2.title{font-size:43px}.photo-grid{grid-template-columns:1fr 1fr;gap:22px 16px}.memory img{height:245px}.photo-grid .memory:nth-child(n+5) img{height:220px}.memory:nth-child(even){margin-top:30px}.memory .caption{font-size:16px}.memory .caption b{font-size:8px}.gallery-bottom{font-size:8px;gap:18px;line-height:1.7}.cinema-layout{display:flex;flex-direction:column;gap:25px}.screen{max-width:310px;padding:12px}.screen video{height:430px}.playlist-area{width:100%}.clip{padding:20px 0}.clip strong{font-size:24px}.cinema-note{font-size:19px;margin-bottom:0}.wish-buttons{grid-template-columns:repeat(6,1fr);gap:9px}.wish-button{font-size:21px}.wish-display{min-height:190px;padding:22px 10px}.wish-display p{font-size:27px}.wishes .intro{font-size:12px}.letter-section{padding:65px 6%}.letter-layout{display:block}.letter-side h2{font-size:43px;margin:15px 0 18px}.letter-side>p{max-width:300px;font-size:12px}.seal-art{display:none}.envelope{margin:35px 5px 0}.envelope summary{padding:55px 20px;min-height:280px}.envelope[open] summary span:last-child{font-size:19px}.letter{font-size:17px;padding:25px 23px}.birthday>p{font-size:12px}.footer{flex-direction:column;align-items:center;text-align:center;padding-bottom:65px;gap:15px}.wish-result{font-size:21px}.modal-bottom{flex-wrap:wrap}dialog p{font-size:17px}.modal-arrows{margin-left:auto}.motion-toggle{font-size:9px}.cake{width:280px;height:235px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}.js .reveal{opacity:1;transform:none}}
</style>
</head>
<body>
<a class="skip" href="#recuerdos">Saltar a los recuerdos</a>
<header class="top"><a class="brand" href="#inicio" aria-label="Briam y May, inicio">b <span>♥</span> m</a><nav class="nav" aria-label="Nuestra celebración"><a href="#recuerdos">Recuerdos</a><a href="#carta">Mi carta</a><a class="desktop" href="#deseo">Tu deseo ↗</a></nav><button class="sound" id="sound" aria-pressed="false">♫ Música: no</button></header>
<main id="inicio">
<section class="hero" aria-labelledby="hero-title">
<div class="orbit" aria-hidden="true"></div><div class="orbit two" aria-hidden="true"></div><span class="sun" aria-hidden="true">✺</span><span class="twinkle" aria-hidden="true">✧</span>
<button class="polaroid photo-a" data-photo="p8" data-caption="mi niña bonita" aria-label="Ampliar foto: mi niña bonita"><img data-img="p8" alt="May, con su carita preciosa"></button>
<button class="polaroid photo-b" data-photo="p20" data-caption="mi persona favorita" aria-label="Ampliar foto: mi persona favorita"><img data-img="p20" alt="Una sonrisa de May"></button>
<button class="polaroid photo-c" data-photo="p1" data-caption="así de linda" aria-label="Ampliar foto: así de linda"><img data-img="p1" alt="May mirando a la cámara"></button>
<button class="polaroid photo-d" data-photo="p21" data-caption="siempre tú ♡" aria-label="Ampliar foto: siempre tú"><img data-img="p21" alt="Otro recuerdo de May"></button>
<div class="hero-center"><div class="birthday-date">03 NOVIEMBRE 2026 <b>✧</b> TU DÍA</div><div class="hero-number" aria-hidden="true">18</div><h1 id="hero-title" aria-label="18 vueltas al sol, Maysita."><em>vueltas al sol,</em>Maysita.</h1><p>Y el mundo es más bonito porque tú estás en él. Feliz cumpleaños, mi amor.</p><a class="pill" href="#recuerdos">Hice esto para ti <span>↓</span></a></div>
<div class="hero-foot"><span>Una pequeña celebración de ti</span><a href="#deseo">Pide un deseo ↗</a><span>Con amor, tu Bri</span></div>
</section>
<div class="marquee" aria-hidden="true"><div><span>mi niña bonita</span><i>✧</i><span>felices 18</span><i>♡</i><span>qué suerte coincidir contigo</span><i>✧</i><span>te amo, Maysita</span><i>♡</i><span>mi niña bonita</span><i>✧</i><span>felices 18</span><i>♡</i><span>qué suerte coincidir contigo</span><i>✧</i><span>te amo, Maysita</span><i>♡</i></div></div>
<section id="recuerdos" class="wrap"><div class="section-top reveal"><div><span class="eyebrow">01 / Mi parte favorita del mundo</span><h2>En todas tus versiones,<br><em>me encantas tú.</em></h2></div><p>Tu mirada, tus caritas, tu sonrisa.<br>Esas pequeñas cosas que hacen que me enamore un poquito más.</p></div><div class="photo-grid">
<button class="memory reveal" data-photo="p23" data-caption="Esa mirada tuya"><img data-img="p23" alt="Retrato de May con el cabello suelto" loading="lazy"><span class="caption">Esa mirada tuya <b>01 ↗</b></span></button>
<button class="memory reveal" data-photo="p20" data-caption="Mi sonrisa favorita"><img data-img="p20" alt="May sonriendo" loading="lazy"><span class="caption">Mi sonrisa favorita <b>02 ↗</b></span></button>
<button class="memory reveal" data-photo="p0" data-caption="Tus mil caritas"><img data-img="p0" alt="Una expresión divertida de May" loading="lazy"><span class="caption">Tus mil caritas <b>03 ↗</b></span></button>
<button class="memory reveal" data-photo="p8" data-caption="Mi lugar bonito"><img data-img="p8" alt="May apoyando la cara en su mano" loading="lazy"><span class="caption">Mi lugar bonito <b>04 ↗</b></span></button>
<button class="memory reveal" data-photo="p16" data-caption="Bonita sin esfuerzo"><img data-img="p16" alt="May con la mano junto a su rostro" loading="lazy"><span class="caption">Bonita sin esfuerzo <b>05 ↗</b></span></button>
<button class="memory reveal" data-photo="p10" data-caption="Cerquita, aun de lejos"><img data-img="p10" alt="Un recuerdo de May durante una videollamada" loading="lazy"><span class="caption">Cerquita, aun de lejos <b>06 ↗</b></span></button>
<button class="memory reveal" data-photo="p21" data-caption="Mi niña preciosa"><img data-img="p21" alt="May mirando a la cámara" loading="lazy"><span class="caption">Mi niña preciosa <b>07 ↗</b></span></button>
<button class="memory reveal" data-photo="p1" data-caption="Una y mil veces, tú"><img data-img="p1" alt="Otra de las caritas de May" loading="lazy"><span class="caption">Una y mil veces, tú <b>08 ↗</b></span></button>
</div><div class="gallery-bottom"><span>UN ÁLBUM CHIQUITO PARA UN AMOR ENORME</span><span>Toca una foto para verla de cerquita ↗</span></div></section>
<section id="cine" class="cinema"><div class="wrap"><div class="section-top reveal"><div><span class="eyebrow">02 / Si pudiera guardar un instante</span><h2>Le daría <em>play</em><br>una y otra vez.</h2></div><p>Porque una foto no alcanza para guardar todas tus ocurrencias, amorcito.</p></div><div class="cinema-layout reveal"><div class="screen"><video id="player" controls playsinline preload="none" aria-label="Videos de May"></video><small id="video-caption">01 — Mi persona favorita · 16 s</small></div><div class="playlist-area"><div class="playlist" aria-label="Elige un recuerdo">
<button class="clip" data-clip="0" aria-pressed="true"><span>01</span><span><strong>Mi persona favorita</strong><small>Un pedacito de nuestras llamadas · 16 s</small></span><span class="play">▶</span></button>
<button class="clip" data-clip="1" aria-pressed="false"><span>02</span><span><strong>Mi niña y sus ocurrencias</strong><small>Así también me encantas :3 · 6 s</small></span><span class="play">▶</span></button>
<button class="clip" data-clip="2" aria-pressed="false"><span>03</span><span><strong>Contigo me río más</strong><small>Ese lado tuyo que tanto amo · 15 s</small></span><span class="play">▶</span></button>
<button class="clip" data-clip="3" aria-pressed="false"><span>04</span><span><strong>Otro ratito contigo</strong><small>De esos que quisiera repetir · 9 s</small></span><span class="play">▶</span></button>
</div><p class="cinema-note">«Hasta a través de una pantalla,<br>me haces sentir cerquita de ti.»</p></div></div></div></section>
<section id="dedicatorias" class="wrap wishes"><div class="reveal"><span class="eyebrow">03 / Dieciocho, como tus vueltas al sol</span><h2 class="title">18 cositas que quiero<br><em>decirte hoy.</em></h2><p class="intro">No me caben en una sola carta, mi amor.<br>Toca cada número; hay un pedacito de mi corazón en todos.</p></div><div class="wish-display" aria-live="polite" aria-atomic="true"><small id="wish-label">PARA TI, MAYSITA</small><p id="wish-text">Elige un número.<br>Todos llevan a ti. ♡</p></div><div id="wish-buttons" class="wish-buttons" aria-label="Dieciocho dedicatorias"></div><p class="wish-count" id="wish-count" aria-live="polite">0 DE 18 PEDACITOS DESCUBIERTOS</p></section>
<section id="carta" class="letter-section"><div class="letter-layout"><div class="letter-side reveal"><span class="eyebrow">04 / De mi corazón al tuyo</span><h2>Hay cosas que<br>solo sé decirte<br><em>con amor.</em></h2><p>Esta carta es un abrazo de esos que quisiera darte y no soltar por un buen ratito.</p><span class="seal-art" aria-hidden="true">❧</span></div><details class="envelope reveal"><summary aria-label="Abrir o cerrar mi carta para Maysita"><span class="wax" aria-hidden="true">b</span><small>TOCA EL SOBRE PARA ABRIRLO</small><span>Para mi Maysita, con amor ♡</span></summary><div class="letter"><p>Feliz cumpleaños, mi amorrr.</p><p>Hoy cumples 18 y quisiera poder darte el abrazo más largo del mundo. Mirarte a los ojitos, decirte lo preciosa que eres y celebrar contigo todo lo lindo que está por venir.</p><p>Desde que llegaste a mi vida, hasta los días más normales tienen algo bonito. Me haces feliz con tus mensajes, con tus caritas, con nuestras llamadas y con esa forma tan tuya de ser. Te juro que a veces me quedo viendo tus fotos y solo pienso en lo afortunado que soy de tenerte.</p><p>Para estos 18 te deseo muchísimas cosas lindas, mi niña. Que puedas perseguir tus sueños, que te rodee gente que te quiera bien y que nunca olvides lo mucho que vales. No tienes que tener toda la vida resuelta hoy. Ve a tu ritmo, disfruta, equivócate, vuelve a intentar. Yo quiero verte crecer y seguir enamorándome de todas tus versiones.</p><p>Gracias por elegirme, por tu cariño y por todos esos ratitos que guardo como un tesoro. Ojalá este detallito te haga sonreír y sentir un poquito de todo el amor que te tengo.</p><p>Felices 18, mi princesa. Que este sea el comienzo de un año tan bonito como tú. Te amo muchísimooo, nunca lo olvides. ♡</p><p class="signature">Tu Brisito, siempre.</p></div></details></div></section>
<section id="deseo" class="wrap birthday"><span class="eyebrow">05 / Falta lo más importante</span><h2 class="title">Cierra los ojitos.<br><em>Pide algo bonito.</em></h2><p>Guárdalo para ti, mi amor.<br>Cuando estés lista, apaga las velitas.</p><div class="cake" id="cake"><svg viewBox="0 0 300 250" role="img" aria-label="Una torta rosa con dos velas que forman el número 18"><ellipse cx="150" cy="224" rx="129" ry="15" fill="#dbc9bb"/><path d="M46 143h208v65q-104 38-208 0z" fill="#ce8797"/><ellipse cx="150" cy="144" rx="104" ry="27" fill="#f3c9ce"/><path d="M46 144c10 10 15 5 20 12s1 27 12 28 10-25 22-23 5 36 17 36 7-30 21-29 9 22 20 21 4-23 20-23 9 32 22 29 7-28 19-32 11 13 21 7 14-17 14-26" fill="#f7dce0"/><path d="M57 208q93 28 186 0" fill="none" stroke="#eeb7c3" stroke-width="6" stroke-linecap="round" stroke-dasharray="1 12"/><ellipse cx="150" cy="144" rx="75" ry="17" fill="none" stroke="#eab3bf" stroke-width="2"/><text x="99" y="132" fill="#a32f46" stroke="#fff0df" stroke-width="1" font-family="Georgia,serif" font-weight="bold" font-size="80">18</text><path d="M120 73v-10m45 10v-10" stroke="#593c30" stroke-width="2"/><g class="flame"><path d="M120 64c-18-10-2-22 0-33 7 13 16 25 0 33" fill="#dea246"/><path d="M120 62c-7-4-2-12 0-16 4 7 6 12 0 16" fill="#fff0b1"/></g><g class="flame" style="animation-delay:-.4s"><path d="M165 64c-18-10-2-22 0-33 7 13 16 25 0 33" fill="#dea246"/><path d="M165 62c-7-4-2-12 0-16 4 7 6 12 0 16" fill="#fff0b1"/></g><g class="smoke" fill="none" stroke="#aa9690" stroke-width="2"><path d="M120 59q-15-12 0-22t0-20"/><path d="M165 59q15-12 0-22t0-20"/></g><path d="M144 149c-10-10-17 3 0 12 17-9 10-22 0-12" fill="#ac3f57"/></svg></div><button class="pill" id="blow">Apagar las velitas <span>✧</span></button><div class="wish-result" id="birthday-result" aria-live="polite">Que la vida te abrace bonito, siempre.</div><button class="reset" id="relight" hidden>Encenderlas otra vez ↺</button></section>
</main><footer class="footer"><span>03.11.2026 · TU CAPÍTULO 18</span><span class="love">Hecho con todo mi amor, para ti.</span><span>BRIAM ♥ MAYSITA</span></footer>
<button class="motion-toggle" id="motion" aria-pressed="false">Ⅱ Pausar efectos</button><canvas class="confetti" id="confetti" aria-hidden="true"></canvas>
<dialog id="photo-modal" aria-label="Nuestros recuerdos"><img id="large-photo" alt=""><div class="modal-bottom"><p id="photo-caption"></p><div class="modal-arrows"><button id="prev-photo" aria-label="Foto anterior">←</button><button id="next-photo" aria-label="Foto siguiente">→</button><button id="close-photo" aria-label="Cerrar foto">Cerrar ×</button></div></div></dialog>
<noscript><p style="padding:30px;text-align:center">Activa JavaScript para ver las fotos y descubrir las sorpresas. La carta se puede abrir sin él.</p></noscript>
<script id="media-data" type="application/json">{"p0": "data:image/jpeg;base64,", "p1": "data:image/jpeg;base64,", "p8": "data:image/jpeg;base64,", "p10": "data:image/jpeg;base64,", "p16": "data:image/jpeg;base64,", "p20": "data:image/jpeg;base64,", "p21": "data:image/jpeg;base64,", "p23": "data:image/jpeg;base64,", "v0": "data:video/mp4;base64,", "poster0": "data:image/jpeg;base64,", "v1": "data:video/mp4;base64,", "poster1": "data:image/jpeg;base64,", "v2": "data:video/mp4;base64,", "poster2": "data:image/jpeg;base64,", "v3": "data:video/mp4;base64,", "poster3": "data:image/jpeg;base64,"}</script>
<script>
'use strict';
const media=JSON.parse(document.getElementById('media-data').textContent);
document.querySelectorAll('[data-img]').forEach(el=>el.src=media[el.dataset.img]);
const reduced=matchMedia('(prefers-reduced-motion: reduce)');let effects=!reduced.matches;
const motion=document.getElementById('motion');function motionUI(){document.body.classList.toggle('still',!effects);motion.textContent=effects?'Ⅱ Pausar efectos':'▷ Activar efectos';motion.setAttribute('aria-pressed',String(!effects))}motionUI();motion.onclick=()=>{effects=!effects;motionUI()};reduced.addEventListener('change',e=>{effects=!e.matches;motionUI()});
if('IntersectionObserver' in window){document.body.classList.add('js');const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');observer.unobserve(e.target)}}),{threshold:.08});document.querySelectorAll('.reveal').forEach(e=>observer.observe(e))}
const photoButtons=[...document.querySelectorAll('[data-photo]')],modal=document.getElementById('photo-modal');let photoIndex=0;function showPhoto(i){photoIndex=(i+photoButtons.length)%photoButtons.length;const b=photoButtons[photoIndex];document.getElementById('large-photo').src=media[b.dataset.photo];document.getElementById('large-photo').alt=b.querySelector('img').alt;document.getElementById('photo-caption').textContent=b.dataset.caption}photoButtons.forEach((b,i)=>b.onclick=()=>{showPhoto(i);modal.showModal()});document.getElementById('prev-photo').onclick=()=>showPhoto(photoIndex-1);document.getElementById('next-photo').onclick=()=>showPhoto(photoIndex+1);document.getElementById('close-photo').onclick=()=>modal.close();modal.addEventListener('click',e=>{if(e.target===modal){const r=modal.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)modal.close()}});modal.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')showPhoto(photoIndex-1);if(e.key==='ArrowRight')showPhoto(photoIndex+1)});
const wishes=['Me encanta esa mirada tuya que me deja todo tontito.','Tu sonrisa puede arreglarme el día, mi amor.','Gracias por hacerme sentir querido, incluso desde lejos.','Amo tus ocurrencias y todas esas caritas que haces :3','Ojalá este año te regale muchísimos motivos para reír.','No dejes de soñar en grande, mi niña. Yo creo en ti.','Qué bonito que entre tanta gente hayamos coincidido.','Tus mensajes hacen que un día normal sea especial.','Me encantan nuestros ratitos juntos, aunque sean por una pantalla.','Deseo que siempre tengas un lugar donde puedas ser tú.','No tienes que ser perfecta para que yo te quiera así de bonito.','Ojalá te vieras un ratito con mis ojos. Entenderías muchas cosas.','Quiero seguir descubriendo todas tus versiones.','Que nunca te falten cariño, calma y ganas de intentar de nuevo.','Gracias por elegirme y por dejarme ser parte de tu vida.','Hoy te celebro a ti, pero me haces feliz todos los días.','Nos quedan muchas sonrisas y recuerdos lindos por guardar.','Si volviera a coincidir contigo, te volvería a elegir. Felices 18, mi amor.'];
const discovered=new Set();const wishBox=document.getElementById('wish-buttons');wishes.forEach((text,i)=>{const b=document.createElement('button');b.className='wish-button';b.textContent=String(i+1).padStart(2,'0');b.setAttribute('aria-label','Descubrir dedicatoria '+(i+1));b.setAttribute('aria-pressed','false');b.onclick=()=>{discovered.add(i);wishBox.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));b.classList.add('seen');document.getElementById('wish-label').textContent='PEDACITO '+String(i+1).padStart(2,'0')+' / 18';document.getElementById('wish-text').textContent=text;document.getElementById('wish-count').textContent=discovered.size===18?'18 DE 18 · Y TODAVÍA ME QUEDA TANTO POR DECIRTE ♡':discovered.size+' DE 18 PEDACITOS DESCUBIERTOS';if(discovered.size===18&&!wishBox.dataset.complete){wishBox.dataset.complete='true';celebrate()}};wishBox.append(b)});
const player=document.getElementById('player'),clips=[...document.querySelectorAll('.clip')];player.src=media.v0;player.poster=media.poster0;const durations=[16,6,15,9];clips.forEach((b,i)=>b.onclick=()=>{player.pause();player.src=media['v'+i];player.poster=media['poster'+i];clips.forEach(x=>x.setAttribute('aria-pressed',String(x===b)));document.getElementById('video-caption').textContent=String(i+1).padStart(2,'0')+' — '+b.querySelector('strong').textContent+' · '+durations[i]+' s';player.load();player.play().catch(()=>{})});player.addEventListener('play',()=>{if(musicOn)toggleMusic(false)});
let audioCtx,musicOn=false,musicTimer;const musicButton=document.getElementById('sound');const melody=[261.63,329.63,392,523.25,440,392,329.63,293.66,261.63,329.63,392,493.88,440,349.23,329.63,293.66];let noteIndex=0;function playNote(){if(!musicOn||document.hidden)return;const t=audioCtx.currentTime;const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.value=melody[noteIndex++%melody.length];g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.055,t+.03);g.gain.exponentialRampToValueAtTime(.001,t+1.5);o.connect(g);g.connect(audioCtx.destination);o.start(t);o.stop(t+1.6)}async function toggleMusic(on){clearInterval(musicTimer);if(on){try{audioCtx=audioCtx||new (window.AudioContext||window.webkitAudioContext)();await audioCtx.resume();musicOn=true;player.pause();playNote();musicTimer=setInterval(playNote,650)}catch{musicOn=false;musicButton.textContent='♫ Audio no disponible';return}}else{musicOn=false;if(audioCtx)audioCtx.suspend()}musicButton.textContent=musicOn?'♫ Música: sí':'♫ Música: no';musicButton.setAttribute('aria-pressed',String(musicOn))}musicButton.onclick=()=>toggleMusic(!musicOn);document.addEventListener('visibilitychange',()=>{if(document.hidden){player.pause();if(musicOn)toggleMusic(false)}});
const canvas=document.getElementById('confetti'),ctx=canvas.getContext('2d');let particles=[],frame=0;function celebrate(){if(!effects)return;const d=Math.min(devicePixelRatio||1,2);canvas.width=innerWidth*d;canvas.height=innerHeight*d;ctx.setTransform(d,0,0,d,0,0);particles=Array.from({length:110},()=>({x:innerWidth/2,y:innerHeight*.55,vx:(Math.random()-.5)*15,vy:-4-Math.random()*12,s:3+Math.random()*5,r:Math.random()*6,c:['#a32f46','#d88d9b','#c49a50','#e8b5ad'][Math.floor(Math.random()*4)],life:0}));cancelAnimationFrame(frame);const draw=()=>{ctx.clearRect(0,0,innerWidth,innerHeight);if(!effects){particles=[];return}particles.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.14;p.r+=.06;p.life++;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.fillStyle=p.c;ctx.globalAlpha=Math.max(0,1-p.life/220);ctx.fillRect(-p.s/2,-p.s/2,p.s,p.s*1.7);ctx.restore()});particles=particles.filter(p=>p.life<220&&p.y<innerHeight+20);if(particles.length)frame=requestAnimationFrame(draw);else ctx.clearRect(0,0,innerWidth,innerHeight)};draw()}
const blow=document.getElementById('blow'),relight=document.getElementById('relight'),cake=document.getElementById('cake');blow.onclick=()=>{cake.classList.add('blown');cake.querySelector('svg').setAttribute('aria-label','Torta de cumpleaños con las velas apagadas');blow.hidden=true;blow.style.display='none';relight.hidden=false;document.getElementById('birthday-result').textContent='¡Felices 18, mi Maysita! Que se cumpla eso que acabas de pedir. Te amo muchísimo. ♡';celebrate();relight.focus({preventScroll:true})};relight.onclick=()=>{cake.classList.remove('blown');cake.querySelector('svg').setAttribute('aria-label','Una torta rosa con dos velas que forman el número 18');blow.hidden=false;blow.style.display='';relight.hidden=true;document.getElementById('birthday-result').textContent='Que la vida te abrace bonito, siempre.';blow.focus({preventScroll:true})};
</script>
</body></html>
